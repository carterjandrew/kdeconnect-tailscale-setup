#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later

set -uo pipefail

readonly PROGRAM_NAME="kdeconnect-tailscale"
readonly PROGRAM_VERSION="0.2.0"
readonly DBUS_SERVICE="org.kde.kdeconnect"
readonly DBUS_PATH="/modules/kdeconnect"
readonly DBUS_INTERFACE="org.kde.kdeconnect.daemon"

declare -a PEER_LABELS=() PEER_IPS=() CUSTOM_ADDRESSES=()

usage() {
    cat <<'HELP'
Usage: kdeconnect-tailscale [command] [addresses]

  add [ADDRESS]                   Add an address (default command)
  repair [OLD_ADDRESS NEW_ADDRESS] Replace an existing address
  peers                           List discovered peers with IPv4 addresses

Without addresses, add and repair use numbered menus of discovered devices.
Direct addresses are literal strings passed to KDE Connect, without lookup or
IP validation. Use them for devices that discovery does not list.
HELP
}

error() {
    printf 'Error: %s\n' "$*" >&2
}

require_command() {
    command -v "$1" >/dev/null 2>&1 && return 0
    error "required command '$1' was not found on PATH"
    return 1
}

prompt() {
    if ! { printf '%s' "$2" >/dev/tty && IFS= read -r "$1" </dev/tty; }; then
        error "could not read interactive input; supply addresses as command arguments"
        return 1
    fi
}

# Return the index through the named variable; never evaluate input as arithmetic.
choose() {
    local result_variable=$1 message=$2 answer i
    shift 2
    local -a options=("$@")
    ((${#options[@]} > 0)) || { error "no options available"; return 1; }
    for i in "${!options[@]}"; do
        printf '%d. %s\n' "$((i + 1))" "${options[i]}"
    done
    prompt answer "$message" || return 1
    for i in "${!options[@]}"; do
        if [[ $answer == "$((i + 1))" ]]; then
            printf -v "$result_variable" '%s' "$i"
            return 0
        fi
    done
    error "invalid menu number '$answer'"
    return 1
}

read_peers() {
    local status rows label address
    require_command tailscale && require_command jq || return 1
    if ! status=$(tailscale status --json 2>&1); then
        error "tailscale status failed: $status"
        return 1
    fi
    if ! rows=$(jq -r '
        if .BackendState != "Running" then error("Tailscale is not running") else
        [(.Peer // {} | to_entries[])
         | .key as $id | .value
         | ([.TailscaleIPs[] | select(contains("."))][0]) as $ip
         | select($ip != null)
         | {name: (if (.HostName // "") == "" then $id else .HostName end),
            os: (.OS // "unknown"), online: (.Online // false), ip: $ip}]
        | sort_by((if .online then 0 else 1 end), (.name | ascii_downcase))
        | .[]
        | [(.name + "  " + .os + "  " + .ip + "  " +
            (if .online then "online" else "offline" end)), .ip]
        | join("\u001f")
        end
    ' <<<"$status" 2>&1); then
        error "could not read Tailscale peers: $rows"
        return 1
    fi
    PEER_LABELS=() PEER_IPS=()
    if [[ -n $rows ]]; then
        while IFS=$'\x1f' read -r label address; do
            PEER_LABELS+=("$label")
            PEER_IPS+=("$address")
        done <<<"$rows"
    fi
    if ((${#PEER_IPS[@]} == 0)); then
        printf 'No peers with IPv4 addresses found. Use add ADDRESS for an unlisted device.\n'
    fi
}

read_custom_addresses() {
    local output addresses
    require_command busctl && require_command jq || return 1
    if ! output=$(busctl --user --json=short get-property \
        "$DBUS_SERVICE" "$DBUS_PATH" "$DBUS_INTERFACE" customDevices 2>&1); then
        error "could not read KDE Connect custom devices (run as your desktop user, without sudo): $output"
        return 1
    fi
    if ! addresses=$(jq -er '
        if .type == "as" and (.data | type) == "array" and
           all(.data[]; type == "string" and length > 0 and (test("[\\x00-\\x1f\\x7f]") | not))
        then .data | join("\n") else error("expected nonempty, single-line address strings") end
    ' <<<"$output" 2>&1); then
        error "unsupported KDE Connect customDevices value: $addresses"
        return 1
    fi
    CUSTOM_ADDRESSES=()
    [[ -z $addresses ]] || mapfile -t CUSTOM_ADDRESSES <<<"$addresses"
    return 0
}

contains_address() {
    local wanted=$1 item
    shift
    for item in "$@"; do
        [[ $item == "$wanted" ]] && return 0
    done
    return 1
}

# Both interactive and direct commands finish here, with literal addresses.
update_addresses() {
    local new_address=$1 old_address=$2 address output changed=0
    local -a updated=()
    if [[ -n $old_address ]]; then
        contains_address "$old_address" "${CUSTOM_ADDRESSES[@]}" || {
            error "'$old_address' is not a configured KDE Connect custom address"
            return 1
        }
        for address in "${CUSTOM_ADDRESSES[@]}"; do
            if [[ $address == "$old_address" && $address != "$new_address" ]]; then
                address=$new_address
                changed=1
            fi
            if ! contains_address "$address" "${updated[@]}"; then
                updated+=("$address")
            else
                changed=1
            fi
        done
    else
        updated=("${CUSTOM_ADDRESSES[@]}")
        if ! contains_address "$new_address" "${updated[@]}"; then
            updated+=("$new_address")
            changed=1
        fi
    fi
    if ((changed)); then
        if ! output=$(busctl --user set-property \
            "$DBUS_SERVICE" "$DBUS_PATH" "$DBUS_INTERFACE" customDevices \
            as "${#updated[@]}" "${updated[@]}" 2>&1); then
            error "could not update KDE Connect custom devices: $output"
            return 1
        fi
    fi
    if ! output=$(busctl --user call \
        "$DBUS_SERVICE" "$DBUS_PATH" "$DBUS_INTERFACE" forceOnNetworkChange 2>&1); then
        error "addresses are configured, but KDE Connect discovery could not be triggered: $output"
        return 1
    fi
    printf 'Configured %s. KDE Connect discovery was triggered.\n' "$new_address"
    printf 'Approve pairing on both devices. For phone setup instructions:\n'
    printf 'https://github.com/carterjandrew/kdeconnect-tailscale-setup#phone-setup\n'
}

configure() {
    local command_name=$1 old_address="" new_address index
    shift
    read_custom_addresses || return 1
    if (($# > 0)); then
        new_address=$1
        if [[ $command_name == repair ]]; then
            old_address=$1
            new_address=$2
        fi
    else
        if [[ $command_name == repair ]]; then
            choose index "Select the address to replace: " "${CUSTOM_ADDRESSES[@]}" || return 1
            old_address=${CUSTOM_ADDRESSES[index]}
        fi
        read_peers || return 1
        choose index "Select a device: " "${PEER_LABELS[@]}" || return 1
        new_address=${PEER_IPS[index]}
    fi
    update_addresses "$new_address" "$old_address"
}

main() {
    local command_name=${1:-add} address
    (($# == 0)) || shift
    case "$command_name/$#" in
        help/0|-h/0|--help/0) usage; return 0 ;;
        --version/0) printf '%s %s\n' "$PROGRAM_NAME" "$PROGRAM_VERSION"; return 0 ;;
        peers/0|add/0|add/1|repair/0|repair/2) ;;
        *) error "invalid command or argument count; see --help"; return 2 ;;
    esac
    for address in "$@"; do
        if [[ -z $address || $address == -* || $address =~ [[:space:][:cntrl:]] ]]; then
            error "addresses must be nonempty, contain no whitespace or control characters, and not start with '-'"
            return 2
        fi
    done
    if [[ $command_name == peers ]]; then
        read_peers || return 1
        ((${#PEER_LABELS[@]} == 0)) || printf '%s\n' "${PEER_LABELS[@]}"
        return 0
    fi
    configure "$command_name" "$@"
}

if [[ -z ${BASH_SOURCE[0]:-} || ${BASH_SOURCE[0]} == "$0" ]]; then
    main "$@"
fi
